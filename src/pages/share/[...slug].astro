---
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { render } from 'astro:content';
import { createCoverMapper } from '../../lib/cover';

export async function getStaticPaths() {
	const shares = await getCollection('shares');
	return shares.map((share) => ({
		params: { slug: share.id },
		props: share,
	}));
}
type Props = CollectionEntry<'shares'>;

const share = Astro.props;
const { Content, headings } = await render(share);
const coverFor = await createCoverMapper();
---

<BlogPost {...share.data} heroImage={coverFor(share)} headings={headings}>
	<Content />
</BlogPost>
