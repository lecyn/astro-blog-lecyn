---
import BaseHead from '../components/BaseHead.astro';
import StructuredData from '../components/StructuredData.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${SITE_TITLE} - 记录编程学习与技术探索`} description={SITE_DESCRIPTION} />
		<StructuredData type="WebSite" />
		<StructuredData type="Person" />
		<style>
			@media (min-width: 1101px) {
				.layout-wrapper {
					display: flex;
					justify-content: center;
					align-items: flex-start;
					padding: 0 1em;
				}
				.layout-wrapper::after {
					content: '';
					width: 260px;
					flex-shrink: 0;
				}
				.layout-wrapper main {
					margin-left: 0;
					margin-right: 0;
				}
			}
			@media (max-width: 1100px) {
				.layout-wrapper {
					display: flex;
					flex-direction: column;
					padding-top: 4rem;
				}
				.layout-wrapper::after {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="layout-wrapper">
			<Sidebar />
		<main>
			<h1>👋 你好，欢迎来到我的博客</h1>
			<p>
				我是一名<strong>热爱代码的学生新手</strong>，正在不断探索编程世界的无限可能。
				这个博客记录了我的<strong>技术学习</strong>、项目实战与<strong>个人成长</strong>的点滴历程。
			</p>
			<p>
				从<strong>前端开发</strong>入门，到尝试搭建自己的博客，每一步都充满挑战与乐趣。
				我相信，<strong>编程</strong>不仅是一项技能，更是一种理解世界的全新方式。
			</p>
			<h2>📌 这里有什么</h2>
			<ul>
				<li><a href="/blog">📝 博客</a> — 学习心得、技术笔记与项目总结</li>
				<li><a href="/notes">📒 笔记</a> — 代码片段、备忘与参考资料</li>
				<li><a href="/share">🔗 分享</a> — 有趣的文章、工具与资源推荐</li>
			</ul>
			<p>
				如果你也是<strong>编程新手</strong>，希望这里的记录能给你一些启发。
				一起加油 💪
			</p>
		</main>
		</div>
		<Footer />
	</body>
</html>
