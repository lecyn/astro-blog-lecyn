---
import { SITE_TITLE } from '../consts';
---

<aside class="sidebar">
	<div class="card">
		<a href="https://www.lecyn.cn" class="avatar-link" aria-label={SITE_TITLE}>
			<img src="/profile-picture.jpg" alt={SITE_TITLE} class="avatar-img" />
		</a>
		<div class="info">
			<div class="name">Lecyn</div>
			<div class="divider"></div>
			<div class="typewriter-container">
				<span class="typewriter" id="typewriter" data-speed="80"></span>
				<span class="cursor">|</span>
			</div>
		</div>
	</div>
</aside>

<style>
	.sidebar {
		width: 260px;
		flex-shrink: 0;
		position: sticky;
		top: 50vh;
		transform: translateY(-50%);
	}
	.card {
		background: var(--glass-bg);
		backdrop-filter: blur(var(--glass-blur));
		-webkit-backdrop-filter: blur(var(--glass-blur));
		border: 1px solid var(--glass-border);
		border-radius: 12px;
		overflow: hidden;
		text-align: center;
	}
	.avatar-link {
		display: block;
		position: relative;
		overflow: hidden;
	}
	.avatar-img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		transition: transform 0.3s ease;
	}
	.avatar-link:hover .avatar-img {
		transform: scale(1.05);
	}
	.avatar-link::after {
		content: "";
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0);
		transition: background 0.3s ease;
		pointer-events: none;
	}
	.avatar-link:hover::after {
		background: rgba(0, 0, 0, 0.25);
	}
	.info {
		padding: 1rem;
	}
	.name {
		font-size: 1.2rem;
		font-weight: 700;
		color: rgb(var(--black));
	}
	.divider {
		width: 20px;
		height: 4px;
		background: var(--accent);
		border-radius: 2px;
		margin: 0.6rem auto;
	}
	.typewriter-container {
		font-size: 0.85rem;
		color: rgb(var(--glass-text));
		min-height: 1.5em;
	}
	.typewriter {
		white-space: pre-line;
	}
	.cursor {
		animation: blink 1s step-end infinite;
	}
	@keyframes blink {
		0%, 100% { opacity: 1; }
		50% { opacity: 0; }
	}

	@media (max-width: 1100px) {
		.sidebar {
			position: static;
			width: 100%;
		}
		.card {
			border-radius: 0;
			display: flex;
			align-items: center;
			gap: 1rem;
			padding: 1rem;
		}
		.avatar-link {
			flex-shrink: 0;
			width: 80px;
			height: 80px;
			border-radius: 50%;
		}
		.avatar-img {
			border-radius: 50%;
		}
		.info {
			padding: 0;
			text-align: left;
			flex: 1;
		}
		.divider {
			margin: 0.3rem 0;
		}
	}
</style>

<script>
	const el = document.getElementById("typewriter");
	if (el) {
		const speed = parseInt(el.dataset.speed) || 80;

		// 从服务器获取所有介绍句子
		fetch('/intros.json')
			.then(response => {
				if (!response.ok) {
					throw new Error('无法加载介绍数据');
				}
				return response.json();
			})
			.then(intros => {
				if (!Array.isArray(intros) || intros.length === 0) {
					throw new Error('介绍数据为空');
				}
				// 随机选取一句
				const randomIntro = intros[Math.floor(Math.random() * intros.length)];
				// 将字面量 "\n" 替换为真实换行符
				const text = randomIntro.replace(/\\n/g, "\n");
				// 设置数据并启动打字机
				el.dataset.text = text;
				startTyping(el, text, speed);
			})
			.catch(error => {
				console.error('获取介绍失败：', error);
				// 出错时显示默认文本
				const fallbackText = "欢迎来到我的博客";
				el.dataset.text = fallbackText;
				startTyping(el, fallbackText, speed);
			});
	}

	function startTyping(element, text, speed) {
		let i = 0;
		function type() {
			if (i < text.length) {
				element.textContent = text.substring(0, i + 1);
				i++;
				setTimeout(type, speed);
			}
		}
		type();
	}
</script>