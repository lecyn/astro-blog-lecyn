---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import StructuredData from '../components/StructuredData.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
	headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, pubDate, updatedDate, heroImage, headings = [] } = Astro.props;

const pageUrl = Astro.url.href;
const category = Astro.url.pathname.split('/')[1] || '';
const categoryLabel = category === 'blog' ? '博客' : category === 'notes' ? '笔记' : category === 'share' ? '分享' : category;
---

<html lang="zh-CN">
	<head>
		<BaseHead
				title={`${title} - ${SITE_TITLE}`}
				description={description}
				image={heroImage}
				ogType="article"
				publishedTime={pubDate}
				modifiedTime={updatedDate}
			/>
			<StructuredData
				type="Article"
				title={title}
				description={description}
				image={heroImage}
				publishedTime={pubDate}
				modifiedTime={updatedDate}
				category={category}
				url={pageUrl}
			/>
			<StructuredData
				type="BreadcrumbList"
				breadcrumbs={[
					{ name: '首页', url: new URL('/', Astro.site).href },
					{ name: categoryLabel, url: new URL(`/${category}/`, Astro.site).href },
					{ name: title, url: pageUrl },
				]}
			/>
		<style>
			@media (min-width: 1101px) {
				.layout-wrapper {
					display: flex;
					justify-content: center;
					align-items: flex-start;
					padding: 0 1em;
				}
				main {
					flex: 1;
					min-width: 0;
					width: auto;
					max-width: none;
					margin: 0;
				}
			}
			@media (max-width: 1100px) {
				.layout-wrapper {
					display: flex;
					flex-direction: column;
					padding-top: 4rem;
				}
				.layout-wrapper::after {
					display: none;
				}
			}
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.prose img {
				cursor: pointer;
			}

			/* Lightbox */
			.lightbox {
				display: none;
				position: fixed;
				inset: 0;
				z-index: 9999;
				background: rgba(0, 0, 0, 0.9);
				overflow: hidden;
			}
			.lightbox.active {
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.lightbox img {
				max-width: 90vw;
				max-height: 90vh;
				object-fit: contain;
				cursor: zoom-in;
				user-select: none;
				-webkit-user-select: none;
				transition: transform 0.15s ease-out;
				will-change: transform;
			}
			.lightbox img.dragging {
				transition: none;
				cursor: grabbing;
			}
			/* 圆形毛玻璃关闭按钮 */
			.lightbox-close {
				position: absolute;
				top: 1.5rem;
				right: 1.5rem;
				width: 3rem;
				height: 3rem;
				border: 1px solid rgba(255, 255, 255, 0.25);
				border-radius: 50%;
				background: rgba(255, 255, 255, 0.12);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				color: #fff;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				transition:
					background 0.2s,
					transform 0.2s;
				z-index: 1;
			}
			.lightbox-close:hover {
				background: rgba(255, 255, 255, 0.25);
				transform: scale(1.08);
			}
			.lightbox-close svg {
				width: 1.3rem;
				height: 1.3rem;
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<div class="layout-wrapper">
			<Sidebar />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage} alt={title} />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										最后更新于 <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
			<TableOfContents headings={headings} />
		</div>
		<Footer />
		<div class="lightbox" id="lightbox">
			<button class="lightbox-close" id="lightbox-close" aria-label="关闭预览">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18" /><path d="M6 6l12 12" /></svg>
			</button>
			<img id="lightbox-img" src="" alt="" draggable="false" />
		</div>
	</body>
</html>

<script>
	const lightbox = document.getElementById('lightbox');
	const lightboxImg = document.getElementById('lightbox-img');
	const lightboxClose = document.getElementById('lightbox-close');

	// 缩放 / 平移状态
	let scale = 1;
	let tx = 0;
	let ty = 0;
	let isDragging = false;
	let startX = 0;
	let startY = 0;
	let originTx = 0;
	let originTy = 0;

	const applyTransform = () => {
		lightboxImg.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
		lightboxImg.style.cursor = scale > 1 ? 'grab' : 'zoom-in';
	};

	const resetTransform = () => {
		scale = 1;
		tx = 0;
		ty = 0;
		applyTransform();
	};

	const openLightbox = (img) => {
		lightboxImg.src = img.src;
		resetTransform();
		lightbox.classList.add('active');
	};

	const closeLightbox = () => {
		lightbox.classList.remove('active');
		lightboxImg.src = '';
		resetTransform();
	};

	document.querySelectorAll('.prose img').forEach((img) => {
		img.addEventListener('click', () => openLightbox(img));
	});

	lightboxClose.addEventListener('click', closeLightbox);

	// 点击遮罩（非图片）关闭
	lightbox.addEventListener('click', (e) => {
		if (e.target === lightbox) closeLightbox();
	});

	// Esc 键关闭
	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && lightbox.classList.contains('active')) closeLightbox();
	});

	// 滚轮缩放
	lightbox.addEventListener(
		'wheel',
		(e) => {
			e.preventDefault();
			const delta = e.deltaY < 0 ? 0.15 : -0.15;
			scale = Math.min(Math.max(scale + delta, 1), 5);
			if (scale <= 1) {
				tx = 0;
				ty = 0;
			}
			applyTransform();
		},
		{ passive: false },
	);

	// 双击切换缩放
	lightboxImg.addEventListener('dblclick', () => {
		if (scale > 1) {
			resetTransform();
		} else {
			scale = 2;
			applyTransform();
		}
	});

	// 拖拽平移（指针事件，兼容鼠标与触摸）
	lightboxImg.addEventListener('pointerdown', (e) => {
		if (scale <= 1) return;
		isDragging = true;
		startX = e.clientX;
		startY = e.clientY;
		originTx = tx;
		originTy = ty;
		lightboxImg.setPointerCapture(e.pointerId);
		lightboxImg.classList.add('dragging');
	});

	lightboxImg.addEventListener('pointermove', (e) => {
		if (!isDragging) return;
		tx = originTx + (e.clientX - startX);
		ty = originTy + (e.clientY - startY);
		applyTransform();
	});

	const endDrag = () => {
		if (!isDragging) return;
		isDragging = false;
		lightboxImg.classList.remove('dragging');
	};

	lightboxImg.addEventListener('pointerup', endDrag);
	lightboxImg.addEventListener('pointercancel', endDrag);

	// 自动拦截文章内容中的站外链接
	const siteHost = location.hostname;
	document.querySelectorAll('.prose a[href]').forEach((a) => {
		let href;
		try {
			href = new URL(a.href);
		} catch {
			return;
		}
		// 跳过站内链接、已设置 target="_blank" 的链接、javascript: 链接
		if (href.hostname === siteHost || a.target === '_blank' || !/^https?:/.test(a.href)) {
			return;
		}
		a.addEventListener('click', (e) => {
			e.preventDefault();
			sessionStorage.setItem('redirect_url', a.href);
			location.href = '/redirect';
		});
	});

	// 为代码块添加顶部标题栏（语言类型 + 复制按钮）
	document.querySelectorAll('.prose pre').forEach((pre) => {
		// 跳过已经处理过的代码块
		if (pre.parentElement?.classList.contains('code-block-wrapper')) return;

		// 创建包装器
		const wrapper = document.createElement('div');
		wrapper.className = 'code-block-wrapper';
		pre.parentNode!.insertBefore(wrapper, pre);

		// 创建顶部标题栏
		const header = document.createElement('div');
		header.className = 'code-block-header';

		// 语言标签
		const lang = pre.getAttribute('data-language');
		const langLabel = document.createElement('span');
		langLabel.className = 'code-language';
		langLabel.innerHTML = '<span class="code-dot"></span>' + (lang || 'text');
		header.appendChild(langLabel);

		// 复制按钮
		const copyBtn = document.createElement('button');
		copyBtn.className = 'copy-button';
		copyBtn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>复制</span>';
		copyBtn.addEventListener('click', async () => {
			const code = pre.querySelector('code')?.textContent || pre.textContent || '';
			try {
				await navigator.clipboard.writeText(code);
			} catch {
				// 降级方案
				const textarea = document.createElement('textarea');
				textarea.value = code;
				textarea.style.position = 'fixed';
				textarea.style.opacity = '0';
				document.body.appendChild(textarea);
				textarea.select();
				document.execCommand('copy');
				document.body.removeChild(textarea);
			}
			copyBtn.classList.add('copied');
			const span = copyBtn.querySelector('span');
			if (span) span.textContent = '已复制';
			setTimeout(() => {
				copyBtn.classList.remove('copied');
				if (span) span.textContent = '复制';
			}, 2000);
		});
		header.appendChild(copyBtn);

		wrapper.appendChild(header);
		wrapper.appendChild(pre);
	});
</script>
