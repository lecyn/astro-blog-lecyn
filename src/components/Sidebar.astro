---
import { SITE_TITLE } from '../consts';
import intros from '../data/intros.json';

const intro = intros[Math.floor(Math.random() * intros.length)];
---

<aside class="sidebar">
	<div class="card">
		<a href="https://www.lecyn.cn" class="avatar-link" aria-label={SITE_TITLE}>
			<img src="/profile-picture.jpg" alt={SITE_TITLE} class="avatar-img" />
		</a>
		<div class="info">
			<div class="name">Lecyn</div>
			<div class="divider"></div>
			<div class="typewriter-container">
				<span class="typewriter" id="typewriter" data-text={intro} data-speed="80"></span>
				<span class="cursor">|</span>
			</div>
		</div>
	</div>
</aside>

<style>
	.sidebar {
		width: 260px;
		flex-shrink: 0;
		position: sticky;
		top: 50vh;
		transform: translateY(-50%);
	}
	.card {
		background: rgb(22, 27, 34 / 0.55);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		overflow: hidden;
		text-align: center;
	}
	.avatar-link {
		display: block;
		position: relative;
		overflow: hidden;
	}
	.avatar-img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		transition: transform 0.3s ease;
	}
	.avatar-link:hover .avatar-img {
		transform: scale(1.05);
	}
	.avatar-link::after {
		content: "";
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0);
		transition: background 0.3s ease;
		pointer-events: none;
	}
	.avatar-link:hover::after {
		background: rgba(0, 0, 0, 0.25);
	}
	.info {
		padding: 1rem;
	}
	.name {
		font-size: 1.2rem;
		font-weight: 700;
		color: rgb(var(--black));
	}
	.divider {
		width: 20px;
		height: 4px;
		background: var(--accent);
		border-radius: 2px;
		margin: 0.6rem auto;
	}
	.typewriter-container {
		font-size: 0.85rem;
		color: rgb(var(--gray));
		min-height: 1.5em;
	}
	.cursor {
		animation: blink 1s step-end infinite;
	}
	@keyframes blink {
		0%, 100% { opacity: 1; }
		50% { opacity: 0; }
	}

	@media (max-width: 1100px) {
		.sidebar {
			position: static;
			width: 100%;
		}
		.card {
			border-radius: 0;
			display: flex;
			align-items: center;
			gap: 1rem;
			padding: 1rem;
		}
		.avatar-link {
			flex-shrink: 0;
			width: 80px;
			height: 80px;
			border-radius: 50%;
		}
		.avatar-img {
			border-radius: 50%;
		}
		.info {
			padding: 0;
			text-align: left;
			flex: 1;
		}
		.divider {
			margin: 0.3rem 0;
		}
	}
</style>

<script>
	const el = document.getElementById("typewriter");
	if (el) {
		const text = el.dataset.text || "";
		const speed = parseInt(el.dataset.speed) || 80;

		let i = 0;
		function type() {
			if (i < text.length) {
				el.textContent = text.substring(0, i + 1);
				i++;
				setTimeout(type, speed);
			}
		}

		type();
	}
</script>
