---
import { getAllTags, tagToPath } from '../lib/tags';

const tags = await getAllTags();
const maxCount = tags.reduce((max, item) => Math.max(max, item.count), 0);

// 按出现次数映射 1~4 级字号
const levelOf = (count: number) => {
	if (maxCount <= 1) return 2;
	const ratio = count / maxCount;
	if (ratio >= 0.8) return 4;
	if (ratio >= 0.55) return 3;
	if (ratio >= 0.3) return 2;
	return 1;
};
---

<aside class="tag-cloud" aria-label="标签云">
	<div class="tag-cloud-head">
		<span class="tag-cloud-title">标签</span>
		<a class="tag-cloud-all" href="/tags/">全部</a>
	</div>
	{
		tags.length > 0 ? (
			<div class="tag-cloud-body">
				{tags.map(({ tag, count }) => (
					<a
						class:list={['tag-chip', `tag-level-${levelOf(count)}`]}
						href={tagToPath(tag)}
					>
						<span>{tag}</span>
						<span class="tag-chip-count">{count}</span>
					</a>
				))}
			</div>
		) : (
			<p class="tag-cloud-empty">暂无标签</p>
		)
	}
</aside>
