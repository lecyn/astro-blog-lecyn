					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		padding: 0.75rem 1rem;
		pointer-events: none;
	}
	nav {
		pointer-events: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		max-width: 1280px;
		margin: 0 auto;
		height: 4rem;
		padding: 0 0.75rem;
		background: var(--glass-bg);
		backdrop-filter: blur(var(--glass-blur));
		-webkit-backdrop-filter: blur(var(--glass-blur));
		border: 1px solid var(--glass-border);
		border-radius: 16px;
		box-shadow:
			0 4px 20px rgba(0, 0, 0, 0.35),
			0 1px 3px rgba(0, 0, 0, 0.4);
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.4rem 0.75rem;
		border-radius: 12px;
		text-decoration: none;
		transition: background 0.2s, transform 0.2s;
		flex-shrink: 0;
	}
	.logo:hover {
		background: rgba(255, 255, 255, 0.06);
	}
	.logo:active {
		transform: scale(0.95);
	}
	.logo img {
		height: 2rem;
		width: auto;
		display: block;
	}
	.logo span {
		font-weight: 700;
		font-size: 1.05rem;
		color: rgb(var(--black));
		white-space: nowrap;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.nav-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		border-radius: 12px;
		color: rgb(var(--glass-text));
		text-decoration: none;
		font-weight: 500;
		white-space: nowrap;
		transition: color 0.2s, background 0.2s, transform 0.2s;
	}
	.nav-item:hover {
		color: rgb(var(--black));
		background: rgba(255, 255, 255, 0.06);
	}
	.nav-item:active {
		transform: scale(0.95);
	}
	.nav-item.active {
		color: rgb(var(--accent-rgb));
		background: rgb(var(--accent-rgb) / 0.15);
		font-weight: 700;
	}
	.nav-item svg {
		width: 1.15rem;
		height: 1.15rem;
		flex-shrink: 0;
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	.social-item {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 12px;
		color: rgb(var(--glass-text));
		text-decoration: none;
		transition: color 0.2s, background 0.2s, transform 0.2s;
	}
	.social-item:hover {
		color: rgb(var(--black));
		background: rgba(255, 255, 255, 0.06);
	}
	.social-item:active {
		transform: scale(0.9);
	}
	.social-item svg {
		width: 1.3rem;
		height: 1.3rem;
	}

	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
		.nav-item {
			padding: 0.5rem 0.65rem;
		}
		.nav-item span {
			display: none;
		}
		.logo span {
			display: none;
		}
	}
</style>
