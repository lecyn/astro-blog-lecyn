---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}
const { headings = [] } = Astro.props as { headings: Heading[] };
const items = headings.filter((h) => h.depth <= 3);
---

<nav class="toc">
	<div class="toc-card">
		{items.length > 0 && (
			<>
				<div class="toc-title">目录</div>
				<ul>
					{items.map((h) => (
						<li class={`toc-depth-${h.depth}`}>
							<a href={`#${h.slug}`}>{h.text}</a>
						</li>
					))}
				</ul>
			</>
		)}
	</div>
</nav>

<style>
	.toc {
		width: 260px;
		flex-shrink: 0;
		position: sticky;
		top: 50vh;
		transform: translateY(-50%);
		max-height: calc(100vh - 5rem);
		overflow-y: auto;
		font-size: 0.85rem;
	}
	.toc-card {
		background: rgb(22, 27, 34 / 0.55);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		padding: 0 1rem 1rem;
	}
	.toc-title {
		padding-top: 1rem;
	}
	.toc-title {
		font-weight: 700;
		color: rgb(var(--black));
		margin-bottom: 0.5rem;
	}
	.toc ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.toc li {
		border-radius: 4px;
		transition: background 0.15s;
	}
	.toc li:hover {
		background: rgba(255, 255, 255, 0.05);
	}
	.toc li a {
		display: block;
		padding: 0.2rem 0.3rem;
		color: rgb(var(--gray));
		text-decoration: none;
		transition: color 0.15s;
	}
	.toc li:hover a {
		color: rgb(var(--black));
	}
	/* 当前阅读章节高亮 */
	.toc li.active {
		background: rgb(var(--accent-rgb) / 0.15);
	}
	.toc li.active a {
		color: rgb(var(--accent-rgb));
		font-weight: 700;
	}
	.toc-depth-2 {
		padding-left: 0.75rem;
	}
	.toc-depth-3 {
		padding-left: 1.5rem;
	}

	@media (max-width: 1200px) {
		.toc {
			display: none;
		}
	}
</style>

<script>
	const toc = document.querySelector('.toc');
	if (toc) {
		const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
		const headings = links
			.map((a) => document.getElementById(decodeURIComponent(a.getAttribute('href')!.slice(1))))
			.filter((el): el is HTMLElement => el !== null);

		let activeIndex = -1;

		const update = () => {
			const offset = 100;
			let current = -1;
			for (let i = 0; i < headings.length; i++) {
				if (headings[i].getBoundingClientRect().top <= offset) {
					current = i;
				} else {
					break;
				}
			}

			// 页面滚动到底部时，强制高亮最后一项
			if (window.innerHeight + window.scrollY >= document.body.scrollHeight - 4) {
				current = headings.length - 1;
			}

			if (current === activeIndex) return;
			activeIndex = current;

			links.forEach((link, i) => {
				const li = link.closest('li');
				if (i === current) {
					li?.classList.add('active');
					// 让目录跟随滚动，将当前项保持在目录中部
					const containerRect = toc.getBoundingClientRect();
					const liRect = li.getBoundingClientRect();
					const targetTop = containerRect.height / 2 - liRect.height / 2;
					toc.scrollTop += liRect.top - containerRect.top - targetTop;
				} else {
					li?.classList.remove('active');
				}
			});
		};

		window.addEventListener('scroll', update, { passive: true });
		window.addEventListener('resize', update, { passive: true });
		update();
	}
</script>
