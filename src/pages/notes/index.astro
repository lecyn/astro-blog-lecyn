---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const notes = (await getCollection('notes')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			@media (min-width: 1101px) {
				.layout-wrapper {
					display: flex;
					justify-content: center;
					align-items: flex-start;
					padding: 0 1em;
				}
				.layout-wrapper::after {
					content: '';
					width: 260px;
					flex-shrink: 0;
				}
				.layout-wrapper main {
					margin-left: 0;
					margin-right: 0;
				}
			}
			@media (max-width: 1100px) {
				.layout-wrapper {
					display: flex;
					flex-direction: column;
					padding-top: 4rem;
				}
				.layout-wrapper::after {
					display: none;
				}
			}
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li a {
				display: flex;
				gap: 1.25rem;
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li a:hover .title,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover .img-wrapper img {
				box-shadow: var(--box-shadow);
			}

			.img-wrapper {
				flex-shrink: 0;
				position: relative;
				border-radius: 8px;
				overflow: hidden;
				width: 280px;
				height: 150px;
			}
			.img-wrapper::after {
				content: '';
				position: absolute;
				inset: 0;
				background: linear-gradient(to right, transparent 55%, rgb(13, 17, 23) 95%);
				pointer-events: none;
			}
			.img-wrapper img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.card-info {
				flex: 1;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				min-width: 0;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.3;
			}
			.desc {
				margin: 0.3rem 0 0;
				font-size: 0.9rem;
				color: rgb(var(--gray));
				overflow: hidden;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
			}
			.date {
				margin: 0.4rem 0 0;
				font-size: 0.85rem;
				color: rgb(var(--gray));
				align-self: flex-end;
			}

			ul li:first-child a {
				flex-direction: column;
				gap: 0.75rem;
			}
			ul li:first-child .img-wrapper {
				width: 100%;
				height: auto;
			}
			ul li:first-child .img-wrapper img {
				aspect-ratio: 16/9;
			}
			ul li:first-child .title {
				font-size: 1.563rem;
			}

			@media (max-width: 720px) {
				ul {
					gap: 1rem;
				}
				.img-wrapper {
					width: 140px;
					height: 90px;
				}
				ul li:first-child .img-wrapper {
					width: 100%;
					height: auto;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="layout-wrapper">
			<Sidebar />
		<main>
			<section>
				<ul>
					{
						notes.map((note) => (
							<li>
								<a href={`/notes/${note.id}/`}>
									<div class="img-wrapper">
										<img width={560} height={300} src={note.data.heroImage} alt="" />
									</div>
									<div class="card-info">
										<h4 class="title">{note.data.title}</h4>
										<p class="desc">{note.data.description}</p>
										<p class="date">
											<FormattedDate date={note.data.pubDate} />
										</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		</div>
		<Footer />
	</body>
</html>
