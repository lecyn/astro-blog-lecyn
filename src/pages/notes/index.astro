---
import BaseHead from '../../components/BaseHead.astro';
import StructuredData from '../../components/StructuredData.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Sidebar from '../../components/Sidebar.astro';
import SideBackground from '../../components/SideBackground.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import TagList from '../../components/TagList.astro';
import TagCloud from '../../components/TagCloud.astro';
import { createCoverMapper } from '../../lib/cover';

const notes = (await getCollection('notes')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const coverFor = await createCoverMapper();

const pageTitle = `笔记 - ${SITE_TITLE}`;
const pageDescription = `学习笔记与代码片段 — ${SITE_DESCRIPTION}`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<StructuredData type="WebSite" />
		<StructuredData
			type="BreadcrumbList"
			breadcrumbs={[
				{ name: '首页', url: new URL('/', Astro.site).href },
				{ name: '笔记', url: new URL('/notes/', Astro.site).href },
			]}
		/>
		<style>
			@media (min-width: 1101px) {
				.layout-wrapper {
					display: flex;
					justify-content: center;
					align-items: flex-start;
					padding: 0 1em;
				}
				.layout-wrapper main {
					flex: 1 1 960px;
					min-width: 0;
					max-width: 960px;
					margin: 0;
				}
			}
			@media (max-width: 1100px) {
				.layout-wrapper {
					display: flex;
					flex-direction: column;
					padding-top: 4rem;
				}
			}
			main {
				width: 960px;
			}
			.post-list {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.post-list > li > a {
				display: flex;
				gap: 1.25rem;
				text-decoration: none;
				transition: 0.2s ease;
			}
			.post-list > li > a:hover .title,
			.post-list > li > a:hover .date {
				color: rgb(var(--accent));
			}
			.post-list a:hover .img-wrapper img {
				box-shadow: var(--box-shadow);
			}
			.card-tags {
				margin-top: 0.6rem;
			}

			.img-wrapper {
				flex-shrink: 0;
				position: relative;
				border-radius: 8px;
				overflow: hidden;
				width: 280px;
				height: 150px;
			}
			.img-wrapper::after {
				content: '';
				position: absolute;
				inset: 0;
				background: linear-gradient(to right, transparent 55%, rgb(13, 17, 23) 95%);
				pointer-events: none;
			}
			.img-wrapper img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.card-info {
				flex: 1;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				min-width: 0;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.3;
			}
			.desc {
				margin: 0.3rem 0 0;
				font-size: 0.9rem;
				color: rgb(var(--gray));
				overflow: hidden;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
			}
			.date {
				margin: 0.4rem 0 0;
				font-size: 0.85rem;
				color: rgb(var(--gray));
				align-self: flex-end;
			}

			.post-list > li:first-child .img-wrapper::after {
				display: none;
			}
			.post-list > li:first-child > a {
				flex-direction: column;
				gap: 0.75rem;
			}
			.post-list > li:first-child .img-wrapper {
				width: 100%;
				height: auto;
			}
			.post-list > li:first-child .img-wrapper img {
				aspect-ratio: 16/9;
			}
			.post-list > li:first-child .title {
				font-size: 1.563rem;
			}

			@media (max-width: 720px) {
				.post-list {
					gap: 1rem;
				}
				.img-wrapper {
					width: 140px;
					height: 90px;
				}
				.post-list > li:first-child .img-wrapper {
					width: 100%;
					height: auto;
				}
			}
		</style>
	</head>
	<body class="post-layout">
		<SideBackground />
		<Header />
		<div class="layout-wrapper">
			<Sidebar />
		<main>
			<section>
				<ul class="post-list">
					{
						notes.map((note) => (
							<li>
								<a href={`/notes/${note.id}/`}>
									<div class="img-wrapper">
										<img width={560} height={300} src={coverFor(note)} alt={note.data.title} />
									</div>
									<div class="card-info">
										<h4 class="title">{note.data.title}</h4>
										<p class="desc">{note.data.description}</p>
										<p class="date">
											<FormattedDate date={note.data.pubDate} />
										</p>
									</div>
								</a>
								<div class="card-tags">
									<TagList tags={note.data.tags} size="sm" />
								</div>
							</li>
						))
					}
				</ul>
				{notes.length === 0 && <p class="empty-hint">还没有笔记，敬请期待。</p>}
			</section>
		</main>
			<TagCloud />
		</div>
		<Footer />
	</body>
</html>
