---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}
const { headings = [] } = Astro.props as { headings: Heading[] };

let h1Counter = 0;
const items = headings
	.filter((h) => h.depth <= 3)
	.map((h) => ({
		...h,
		index: h.depth === 1 ? ++h1Counter : null,
	}));
---

<nav class="toc">
	<div class="toc-card">
		{items.length > 0 && (
			<>
				<div class="toc-title">目录</div>
				<div class="toc-list" id="toc-list">
					<div class="toc-indicator" id="toc-indicator"></div>
					{items.map((h) => (
						<a class={`toc-item toc-level-${h.depth}`} href={`#${h.slug}`} data-slug={h.slug} data-depth={h.depth}>
							<span class="toc-badge">{h.depth === 1 ? h.index : ''}</span>
							<span class="toc-label">{h.text}</span>
						</a>
					))}
				</div>
			</>
		)}
	</div>
</nav>

<style>
	.toc {
		width: 260px;
		flex-shrink: 0;
		position: sticky;
		top: 50vh;
		transform: translateY(-50%);
		max-height: calc(100vh - 5rem);
		overflow-y: auto;
		font-size: 0.85rem;
		scrollbar-width: thin;
		scrollbar-color: rgb(var(--gray-light)) transparent;
	}
	.toc::-webkit-scrollbar {
		width: 4px;
	}
	.toc::-webkit-scrollbar-track {
		background: transparent;
	}
	.toc::-webkit-scrollbar-thumb {
		background: rgb(var(--gray-light) / 0.8);
		border-radius: 2px;
	}
	.toc-card {
		background: var(--glass-bg);
		backdrop-filter: blur(var(--glass-blur));
		-webkit-backdrop-filter: blur(var(--glass-blur));
		border: 1px solid var(--glass-border);
		border-radius: 12px;
		padding: 0 0.5rem 0.75rem;
	}
	.toc-title {
		padding: 1rem 0.5rem 0.5rem;
		font-weight: 700;
		color: rgb(var(--black));
	}

	/* 目录项容器与滑动指示器 */
	.toc-list {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.14rem;
		padding: 0.0625rem 0;
	}
	.toc-indicator {
		position: absolute;
		left: 0;
		right: 0;
		top: 0;
		height: 0;
		border-radius: 0.75rem;
		background: rgb(var(--accent-rgb) / 0.1);
		border: 2px dashed rgb(var(--accent-rgb) / 0.35);
		opacity: 0;
		transition:
			top 0.18s ease,
			height 0.18s ease,
			opacity 0.14s ease;
		pointer-events: none;
		z-index: 0;
	}

	.toc-item {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.24rem 0.62rem;
		min-height: 1.4rem;
		border-radius: 0.875rem;
		color: rgb(var(--glass-text));
		text-decoration: none;
		line-height: 1.5;
		transition:
			background-color 0.14s ease,
			transform 0.14s ease,
			color 0.14s ease;
	}
	.toc-item:hover {
		background: rgba(255, 255, 255, 0.06);
		transform: translateX(1px);
		color: rgb(var(--black));
	}
	.toc-item.active {
		color: rgb(var(--accent-rgb));
	}

	/* 徽章列：统一 1.25rem，垂直对齐 */
	.toc-badge {
		flex-shrink: 0;
		width: 1.25rem;
		height: 1.25rem;
		border-radius: 0.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.68rem;
		font-weight: 700;
		line-height: 1;
	}
	/* h1：序号徽章 */
	.toc-level-1 .toc-badge {
		background: rgb(var(--accent-rgb) / 0.16);
		color: rgb(var(--accent-rgb));
	}
	/* h2：小方块 */
	.toc-level-2 .toc-badge::after {
		content: "";
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 0.1875rem;
		background: rgb(var(--accent-rgb) / 0.5);
		transition: background 0.14s ease;
	}
	/* h3：小圆点 */
	.toc-level-3 .toc-badge::after {
		content: "";
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 0.125rem;
		background: rgba(255, 255, 255, 0.14);
		transition: background 0.14s ease;
	}
	/* 缩进：作用于徽章列，保持指示器全宽 */
	.toc-level-2 .toc-badge {
		margin-left: 1rem;
	}
	.toc-level-3 .toc-badge {
		margin-left: 2rem;
	}
	/* 活动时色块变主色 */
	.toc-item.active .toc-badge::after {
		background: rgb(var(--accent-rgb));
	}

	.toc-label {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		min-width: 0;
		flex: 1;
	}

	@media (max-width: 1200px) {
		.toc {
			display: none;
		}
	}
</style>

<script>
	const toc = document.querySelector('.toc');
	if (toc) {
		const list = toc.querySelector<HTMLElement>('.toc-list');
		const indicator = toc.querySelector<HTMLElement>('.toc-indicator');
		const items = Array.from(toc.querySelectorAll<HTMLAnchorElement>('.toc-item'));
		const depths = items.map((el) => parseInt(el.dataset.depth || '2', 10));
		const headings = items
			.map((el) => document.getElementById(decodeURIComponent(el.getAttribute('href')!.slice(1))))
			.filter((el): el is HTMLElement => el !== null);

		// 顶栏（sticky header）高度补偿
		const OFFSET = 90;
		let current = -1;
		let ticking = false;

		// 计算当前活动标题索引（滚动位置法）
		const getCurrentIndex = () => {
			let next = -1;
			for (let i = 0; i < headings.length; i++) {
				if (headings[i].getBoundingClientRect().top <= OFFSET) {
					next = i;
				} else {
					break;
				}
			}
			// 滚动到底部时强制高亮最后一项
			if (window.innerHeight + window.scrollY >= document.body.scrollHeight - 4) {
				next = headings.length - 1;
			}
			return next;
		};

		const apply = () => {
			items.forEach((el) => el.classList.remove('active'));

			if (current < 0) {
				if (indicator) indicator.style.opacity = '0';
				return;
			}

			// 向上回溯，找出当前章节的父级标题范围（多级联动高亮）
			let min = current;
			let prevDepth = depths[current];
			for (let i = current - 1; i >= 0; i--) {
				if (depths[i] < prevDepth) {
					min = i;
					prevDepth = depths[i];
				}
			}

			const minEl = items[min];
			const maxEl = items[current];
			const top = minEl.offsetTop;
			const height = maxEl.offsetTop + maxEl.offsetHeight - top;

			if (indicator) {
				indicator.style.opacity = '1';
				indicator.style.top = `${top}px`;
				indicator.style.height = `${height}px`;
			}

			for (let i = min; i <= current; i++) {
				items[i].classList.add('active');
			}

			// 让目录容器跟随滚动，将活动章节保持在可见区域
			const containerRect = toc.getBoundingClientRect();
			const minRect = minEl.getBoundingClientRect();
			const maxRect = maxEl.getBoundingClientRect();
			const visibleHeight = maxRect.bottom - minRect.top;
			let targetTop: number;
			if (visibleHeight < 0.9 * containerRect.height) {
				targetTop = minEl.offsetTop - 32;
			} else {
				targetTop = maxEl.offsetTop - toc.clientHeight * 0.8;
			}
			toc.scrollTo({ top: Math.max(0, targetTop), behavior: 'smooth' });
		};

		const update = () => {
			ticking = false;
			const next = getCurrentIndex();
			if (next === current) return;
			current = next;
			apply();
		};

		const onScroll = () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		};

		// 点击目录项：平滑滚动到对应标题
		items.forEach((el, i) => {
			el.addEventListener('click', (e) => {
				e.preventDefault();
				const id = decodeURIComponent(el.getAttribute('href')!.slice(1));
				const target = document.getElementById(id);
				if (!target) return;
				const top = target.getBoundingClientRect().top + window.scrollY - OFFSET;
				window.scrollTo({ top, behavior: 'smooth' });
				history.replaceState(null, '', `#${id}`);
				current = i;
				apply();
			});
		});

		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onScroll, { passive: true });
		apply();
	}
</script>
