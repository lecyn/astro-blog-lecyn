---
import BaseHead from '../../components/BaseHead.astro';
import StructuredData from '../../components/StructuredData.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Sidebar from '../../components/Sidebar.astro';
import SideBackground from '../../components/SideBackground.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import TagList from '../../components/TagList.astro';
import TagCloud from '../../components/TagCloud.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { COLLECTION_LABELS, entryHref, getAllTags, getEntriesByTag } from '../../lib/tags';

export async function getStaticPaths() {
	const tags = await getAllTags();
	return tags.map(({ tag }) => ({
		params: { tag },
		props: { tag },
	}));
}

const { tag } = Astro.props;
const entries = await getEntriesByTag(tag);

const pageTitle = `标签：${tag} - ${SITE_TITLE}`;
const pageDescription = `带有「${tag}」标签的全部内容，共 ${entries.length} 篇 — ${SITE_DESCRIPTION}`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<StructuredData type="WebSite" />
		<StructuredData
			type="BreadcrumbList"
			breadcrumbs={[
				{ name: '首页', url: new URL('/', Astro.site).href },
				{ name: '标签', url: new URL('/tags/', Astro.site).href },
				{ name: tag, url: Astro.url.href },
			]}
		/>
		<style>
			@media (min-width: 1101px) {
				.layout-wrapper {
					display: flex;
					justify-content: center;
					align-items: flex-start;
					padding: 0 1em;
				}
				.layout-wrapper main {
					flex: 1 1 960px;
					min-width: 0;
					max-width: 960px;
					margin: 0;
				}
			}
			@media (max-width: 1100px) {
				.layout-wrapper {
					display: flex;
					flex-direction: column;
					padding-top: 4rem;
				}
			}
			main {
				width: 960px;
			}
			.page-head {
				margin-bottom: 1.5rem;
			}
			.back-link {
				font-size: 0.8rem;
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.back-link:hover {
				color: var(--accent-dark);
			}
			.page-title {
				margin: 0.4rem 0 0;
				font-size: 1.75rem;
				color: rgb(var(--black));
			}
			.page-desc {
				margin: 0.4rem 0 0;
				font-size: 0.85rem;
				color: rgb(var(--gray));
			}
			.entry-list {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.entry-list > li > a {
				display: flex;
				gap: 1.25rem;
				text-decoration: none;
				transition: 0.2s ease;
			}
			.entry-list > li > a:hover .entry-title,
			.entry-list > li > a:hover .entry-meta {
				color: rgb(var(--accent));
			}
			.thumb {
				flex-shrink: 0;
				position: relative;
				width: 280px;
				height: 150px;
				border-radius: 8px;
				overflow: hidden;
			}
			.thumb img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.entry-info {
				flex: 1;
				display: flex;
				flex-direction: column;
				min-width: 0;
			}
			.entry-meta {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				font-size: 0.78rem;
				color: rgb(var(--gray));
			}
			.badge {
				padding: 0.05em 0.55em;
				border: 1px solid var(--glass-border);
				border-radius: 999px;
				background: rgb(var(--gray-light) / 0.6);
				color: rgb(var(--glass-text));
			}
			.entry-title {
				margin: 0.35rem 0 0;
				color: rgb(var(--black));
				font-size: 1.15rem;
				line-height: 1.35;
			}
			.entry-desc {
				margin: 0.3rem 0 0;
				font-size: 0.9rem;
				color: rgb(var(--gray));
				overflow: hidden;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
			}
			.entry-tags {
				margin-top: 0.6rem;
			}
			.empty {
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				.entry-list {
					gap: 1rem;
				}
				.thumb {
					width: 140px;
					height: 90px;
				}
			}
		</style>
	</head>
	<body class="post-layout">
		<SideBackground />
		<Header />
		<div class="layout-wrapper">
			<Sidebar />
		<main>
			<section>
				<div class="page-head">
					<a class="back-link" href="/tags/">← 全部标签</a>
					<h1 class="page-title">#{tag}</h1>
					<p class="page-desc">共 {entries.length} 篇内容</p>
				</div>
				{
					entries.length > 0 ? (
						<ul class="entry-list">
							{entries.map(({ collection, entry }) => (
								<li>
									<a href={entryHref(collection, entry.id)}>
										<div class="thumb">
											<img
												width={560}
												height={300}
												src={entry.data.heroImage}
												alt={entry.data.title}
											/>
										</div>
										<div class="entry-info">
											<div class="entry-meta">
												<span class="badge">{COLLECTION_LABELS[collection]}</span>
												<span>
													<FormattedDate date={entry.data.pubDate} />
												</span>
											</div>
											<h2 class="entry-title">{entry.data.title}</h2>
											<p class="entry-desc">{entry.data.description}</p>
										</div>
									</a>
									<div class="entry-tags">
										<TagList tags={entry.data.tags} size="sm" />
									</div>
								</li>
							))}
						</ul>
					) : (
						<p class="empty">该标签下暂无内容。</p>
					)
				}
			</section>
		</main>
			<TagCloud />
		</div>
		<Footer />
	</body>
</html>
